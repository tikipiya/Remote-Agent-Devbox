NODE_ENV=development
RAD_HOST=127.0.0.1
RAD_PORT=3000
RAD_DATABASE_URL=postgresql://rad:rad@127.0.0.1:5432/rad
RAD_POSTGRES_PASSWORD=change-this-before-deployment
RAD_DEPLOYMENT_TIER=1
RAD_SANDBOX_BACKEND=docker
RAD_WORKSPACE_IMAGE=ghcr.io/tikipiya/remote-agent-devbox/workspace-node:local
RAD_WORKSPACE_NETWORK=rad-workspace
RAD_CONTROL_NETWORK=rad-control
RAD_WORKSPACE_MEMORY_MB=2048
RAD_WORKSPACE_CPUS=2
RAD_WORKSPACE_PIDS=256
RAD_WORKSPACE_TTL_SECONDS=14400
RAD_RECONCILE_INTERVAL_MS=5000
RAD_ARTIFACT_ROOT=/var/lib/rad/artifacts
RAD_ARTIFACT_MAX_BYTES=67108864
RAD_ARTIFACT_VOLUME=rad-artifacts
RAD_VALIDATOR_IMAGE=remote-agent-devbox-validator:local
# Fail-closed validation requires the exact local image ID from:
# docker image inspect --format '{{.Id}}' remote-agent-devbox-validator:local
RAD_VALIDATOR_IMAGE_DIGEST=
RAD_VALIDATOR_MEMORY_MB=512
RAD_VALIDATOR_CPUS=1
RAD_VALIDATOR_PIDS=64
RAD_VALIDATOR_TIMEOUT_MS=120000
RAD_APPROVAL_TTL_SECONDS=3600
# Required only for approved Git writes. Store the PEM private key as base64.
RAD_GITHUB_API_URL=https://api.github.com
RAD_GITHUB_APP_ID=
RAD_GITHUB_INSTALLATION_ID=
RAD_GITHUB_PRIVATE_KEY_BASE64=
# Required for agent tasks. It is forwarded only to the short-lived trusted
# agent runner, never to the untrusted Workspace container.
RAD_CODEX_API_KEY=
# Optional. If omitted, Discord integration remains disabled.
RAD_DISCORD_TOKEN=
RAD_DISCORD_APPLICATION_ID=
# Optional. Guild-scoped command updates are immediate during development.
RAD_DISCORD_GUILD_ID=
