{
  "name": "remote-agent-devbox",
  "version": "0.0.0",
  "private": true,
  "description": "A secure, self-hosted runtime for remote AI development agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=@rad/web",
    "check": "npm run typecheck && npm run test",
    "dev": "npm run dev --workspace=@rad/control",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify:codex-boundary": "npm run build && node scripts/verify-codex-exec-boundary.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
